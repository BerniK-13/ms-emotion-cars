---
import '../styles/global.css';
import {withBase} from '../utils/paths.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSequence from '../components/HeroSequence.astro';
const {title='Exklusive Automobile',description='MS EMotion Cars – exklusiver Fahrzeugverkauf und Ankauf. Demo-Prototyp.'} = Astro.props;
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#101112"/><title>{title} | MS EMotion Cars</title><link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml"/></head><body><a class="skip" href="#main">Zum Inhalt springen</a><Header/><main id="main"><slot/></main><Footer/><HeroSequence/><script is:inline>document.documentElement.classList.add('js');</script></body></html>
