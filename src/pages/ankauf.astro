---
import InnerHero from '../components/InnerHero.astro';
import Base from '../layouts/Base.astro';import InquiryForm from '../components/InquiryForm.astro';
import copy from '../../content/pages/ankauf.json';
---
<Base title={copy.text_011} description="Bieten Sie MS EMotion Cars Ihr exklusives Fahrzeug zum Ankauf an."><InnerHero eyebrow={copy.text_010} title={copy.text_012} accent={copy.text_013} description={copy.text_014} image="/images/referenzen.png" position="center 52%"/><section class="section"><div class="shell split-layout"><div><span class="eyebrow eyebrow-dark">{copy.text_001}</span><h2>{copy.text_002}<br/><em>{copy.text_003}</em></h2><p>{copy.text_004}</p><div class="step-list"><div><strong>01</strong><span>{copy.text_005}</span></div><div><strong>02</strong><span>{copy.text_006}</span></div><div><strong>03</strong><span>{copy.text_007}</span></div></div></div><div class="inquiry-panel"><h3>{copy.text_008}</h3><p>{copy.text_009}</p><InquiryForm kind="purchase"/></div></div></section></Base>
