---
import {withBase} from '../utils/paths.js';
import Base from '../layouts/Base.astro';
import HomeScrollReveal from '../components/HomeScrollReveal.astro';import CarCard from '../components/CarCard.astro';import {cars} from '../data/cars.js';
import copy from '../../content/pages/startseite.json';
---
<Base title={"3D Test – " + copy.text_039} description="MS EMotion Cars – exklusiver digitaler Showroom für besondere Sportwagen und Premiumautomobile. Exklusive Fahrzeugauswahl."><section class="sequence-test" data-sequence><div class="sequence-stage"><div class="sequence-frames" aria-hidden="true"><img class="sequence-frame is-active" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(01).jpg")} alt="" loading="eager" decoding="async" /><img class="sequence-frame" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(04).jpg")} alt="" loading="lazy" decoding="async" /><img class="sequence-frame" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(07).jpg")} alt="" loading="lazy" decoding="async" /><img class="sequence-frame" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(10-1).jpg")} alt="" loading="lazy" decoding="async" /><img class="sequence-frame" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(12).jpg")} alt="" loading="lazy" decoding="async" /><img class="sequence-frame" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(16).jpg")} alt="" loading="lazy" decoding="async" /><img class="sequence-frame" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(19).jpg")} alt="" loading="lazy" decoding="async" /><img class="sequence-frame" src={withBase("/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(23).jpg")} alt="" loading="lazy" decoding="async" /></div><div class="sequence-shade"></div><div class="shell sequence-content"><div class="sequence-copy"><span class="eyebrow">{copy.text_001}</span><h1>{copy.text_002}<br/>{copy.text_003} <em>{copy.text_004}</em></h1><p>{copy.text_005}</p><a class="button button-outline" href={withBase("/fahrzeuge")}>{copy.text_006} <span>↗</span></a></div></div><div class="sequence-progress" aria-hidden="true"><span></span></div><div class="sequence-label">PORSCHE 992.2 GT3 WEISSACH <span>·</span> SCROLL TO EXPLORE</div></div></section><section class="intro-strip" style={`--intro-carbon: url("${withBase("/images/carbon.jpeg")}")`}><div class="shell strip-inner" data-home-reveal><span>{copy.text_007}</span><p>{copy.text_008}</p><span>{copy.text_009}</span></div></section><section class="section collection"><div class="shell"><div class="section-heading" data-home-reveal><div><span class="eyebrow eyebrow-dark">{copy.text_010}</span><h2>{copy.text_011}<br/><em>{copy.text_012}</em></h2></div><p>{copy.text_013}</p></div><div class="car-grid" data-home-reveal-group>{cars.slice(0,3).map(car=><CarCard car={car}/>)}</div><div class="section-end" data-home-reveal><a class="text-link" href={withBase("/fahrzeuge")}>{copy.text_014} <span>↗</span></a></div></div></section><section class="buy-section" style={`--carbon-url: url("${withBase("/images/carbon.jpeg")}")`}><div class="shell buy-content"><div data-home-reveal><div><span class="eyebrow">{copy.text_015}</span><h2>{copy.text_016}<br/><em>{copy.text_017}</em></h2><p>{copy.text_018}</p><a class="button button-outline" href={withBase("/ankauf")}>{copy.text_019} <span>↗</span></a></div></div><div class="buy-art" aria-hidden="true"></div></div></section><section class="section philosophy"><div class="shell philosophy-grid"><div data-home-reveal><span class="eyebrow eyebrow-dark">{copy.text_020}</span><h2>{copy.text_021}<br/>{copy.text_022} <em>{copy.text_023}</em></h2></div><div data-home-reveal><p>{copy.text_024}</p><p class="muted">{copy.text_025}</p><a class="text-link" href={withBase("/ueber-uns")}>{copy.text_026} <span>↗</span></a></div></div></section><section class="values" aria-label="Schnellnavigation"><nav class="shell values-grid" aria-label="Weitere Seiten"><a class="value-link" data-home-reveal href={withBase("/fahrzeuge")}><span class="value-number">01</span><h3>{copy.text_027}</h3><p>{copy.text_028}</p></a><a class="value-link" href={withBase("/referenzen")}><span class="value-number">02</span><h3>{copy.text_029}</h3><p>{copy.text_030}</p></a><a class="value-link" href={withBase("/ms-collection")}><span class="value-number">03</span><h3>{copy.text_031}</h3><p>{copy.text_032}</p></a><a class="value-link" href={withBase("/ankauf")}><span class="value-number">04</span><h3>{copy.text_033}</h3><p>{copy.text_034}</p></a><a class="value-link" href={withBase("/ueber-uns")}><span class="value-number">05</span><h3>{copy.text_035}</h3><p>{copy.text_036}</p></a><a class="value-link" href={withBase("/kontakt")}><span class="value-number">06</span><h3>{copy.text_037}</h3><p>{copy.text_038}</p></a></nav></section><HomeScrollReveal/><style>
.sequence-test{position:relative;height:310vh;background:#08090a;color:white}
.sequence-stage{position:sticky;top:0;height:100vh;min-height:620px;overflow:hidden;isolation:isolate;background:#08090a}
.sequence-frames,.sequence-frame,.sequence-shade{position:absolute;inset:0;width:100%;height:100%}
.sequence-frames{z-index:-2}
.sequence-frame{object-fit:cover;object-position:center;opacity:0;transition:opacity .35s ease;filter:brightness(.72) saturate(.82)}
.sequence-frame.is-active{opacity:1}
.sequence-shade{z-index:-1;background:linear-gradient(90deg,rgba(4,5,7,.94) 0%,rgba(4,5,7,.78) 28%,rgba(4,5,7,.32) 57%,rgba(4,5,7,.12) 100%),linear-gradient(0deg,rgba(0,0,0,.4),transparent 30%)}
.sequence-content{height:100%;display:flex;align-items:center;position:relative;z-index:2}
.sequence-copy{max-width:750px;opacity:var(--sequence-copy-opacity,1);transform:translateY(var(--sequence-copy-y,0px));transition:opacity .15s linear}
.sequence-copy h1{font-family:'Italiana',Georgia,serif;font-size:clamp(3.7rem,7vw,8rem);font-weight:400;line-height:.97;text-transform:uppercase;margin:30px 0}
.sequence-copy h1 em{color:#991B26;font-style:normal}
.sequence-copy>p{max-width:560px;color:#ddd;line-height:1.8;margin-bottom:30px}
.sequence-progress{position:absolute;right:28px;top:25%;height:50%;width:2px;background:rgba(255,255,255,.25);z-index:3}
.sequence-progress span{display:block;width:100%;height:var(--sequence-progress,0%);background:#991B26}
.sequence-label{position:absolute;bottom:30px;right:30px;font-size:10px;letter-spacing:.18em;color:#ddd;z-index:3}
.sequence-label span{color:#991B26;margin:0 8px}
@media(max-width:760px){.sequence-test{height:245vh}.sequence-stage{min-height:0}.sequence-frame{object-position:60% center}.sequence-shade{background:linear-gradient(90deg,rgba(4,5,7,.89),rgba(4,5,7,.38)),linear-gradient(0deg,rgba(0,0,0,.45),transparent 50%)}.sequence-copy h1{font-size:clamp(3rem,11vw,5rem)}.sequence-label{right:18px;bottom:22px;font-size:8px}.sequence-progress{right:12px}}
@media(prefers-reduced-motion:reduce){.sequence-test{height:100vh}.sequence-frame:not(:first-child){display:none}.sequence-frame:first-child{opacity:1}.sequence-progress{display:none}}
</style>
<script>
const sequence=document.querySelector('[data-sequence]');
if(sequence && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
 const frames=[...sequence.querySelectorAll('.sequence-frame')];
 let pending=false;
 const update=()=>{
  const max=Math.max(1,sequence.offsetHeight-window.innerHeight);
  const progress=Math.max(0,Math.min(1,-sequence.getBoundingClientRect().top/max));
  const index=Math.min(frames.length-1,Math.floor(progress*frames.length));
  frames.forEach((frame,i)=>frame.classList.toggle('is-active',i===index));
  sequence.style.setProperty('--sequence-progress',(progress*100)+'%');
  sequence.style.setProperty('--sequence-copy-opacity',String(Math.max(0,1-progress*2.8)));
  sequence.style.setProperty('--sequence-copy-y',(-progress*55)+'px');
  pending=false;
 };
 const onScroll=()=>{if(!pending){pending=true;requestAnimationFrame(update)}};
 window.addEventListener('scroll',onScroll,{passive:true});
 window.addEventListener('resize',onScroll,{passive:true});
 update();
}
</script>
</Base>