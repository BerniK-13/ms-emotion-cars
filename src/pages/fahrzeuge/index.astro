---
import InnerHero from '../../components/InnerHero.astro';
import Base from '../../layouts/Base.astro';
import CarCard from '../../components/CarCard.astro';
import {cars} from '../../data/cars.js';
---
<Base title="Fahrzeuge" description="Entdecken Sie unsere Fahrzeugauswahl bei MS EMotion Cars.">
  <InnerHero eyebrow="01 / IN STOCK" title="For those" accent="who know." description="Außergewöhnliche Automobile. Mit Liebe zum Detail präsentiert." image="/images/hecks.png" position="center 58%" className="inventory-page"/>
  <section class="section listing"><div class="shell">
    <div class="filter-bar"><div class="filter-buttons" aria-label="Fahrzeuge filtern"><button type="button" class="filter active" data-filter="Alle" aria-pressed="true">ALLE</button><button type="button" class="filter" data-filter="Porsche" aria-pressed="false">PORSCHE</button><button type="button" class="filter" data-filter="BMW" aria-pressed="false">BMW</button></div></div>
    <p id="result-count" class="results" aria-live="polite">{cars.length} Fahrzeuge</p>
    <div class="car-grid" id="inventory">{cars.map(car=><div class="inventory-item" data-brand={car.brand}><CarCard car={car}/></div>)}</div>
    <p id="empty-state" hidden>Keine Fahrzeuge in dieser Kategorie.</p>
  </div></section>
</Base>
<script>
const items=[...document.querySelectorAll('.inventory-item')];
document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{
 const brand=button.dataset.filter;
 document.querySelectorAll('[data-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});
 let count=0;items.forEach(item=>{const show=brand==='Alle'||item.dataset.brand===brand;item.hidden=!show;if(show)count++;});
 document.querySelector('#result-count').textContent=`${count} Fahrzeuge`;
 document.querySelector('#empty-state').hidden=count!==0;
}));
</script>
