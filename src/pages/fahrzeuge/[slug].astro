---
import Base from '../../layouts/Base.astro';import InquiryForm from '../../components/InquiryForm.astro';import {cars,euro,number} from '../../data/cars.js';
export function getStaticPaths(){return cars.map(car=>({params:{slug:car.slug},props:{car}}));}
const {car}=Astro.props;
---
<Base title={`${car.brand} ${car.model}`} description={`Demo-Fahrzeug ${car.brand} ${car.model}. Keine echte Verkaufsanzeige.`}><section class="detail-top"><div class="shell"><a class="back-link" href="/fahrzeuge">← ZURÜCK ZU DEN FAHRZEUGEN</a><div class="detail-title"><div><span class="eyebrow eyebrow-dark">{car.brand.toUpperCase()} / DEMO-FAHRZEUG</span><h1>{car.model}</h1></div><strong>{euro(car.price)}</strong></div><div class="detail-image"><img src={car.image} alt={`Illustration ${car.brand} ${car.model}, kein echtes Fahrzeugfoto`} width="900" height="550"/><span>DEMO-BILD · KEIN ECHTES FAHRZEUG</span></div><div class="detail-stats"><div><span>ERSTZULASSUNG</span><strong>{car.year}</strong></div><div><span>KILOMETER</span><strong>{number(car.km)} km</strong></div><div><span>LEISTUNG</span><strong>{car.power} PS</strong></div><div><span>FAHRZEUGTYP</span><strong>{car.type}</strong></div></div></div></section><section class="section detail-body"><div class="shell detail-columns"><div><span class="eyebrow eyebrow-dark">THE DETAILS</span><h2>Ein besonderer<br/><em>Charakter.</em></h2><p>{car.description}</p><h3>Ausstattung (Demodaten)</h3><ul class="feature-list">{car.features.map(f=><li>{f}</li>)}</ul><p class="muted">Wichtig: Preis, Kilometerstand, Ausstattung und Verfügbarkeit sind frei erfunden. Dies ist keine Verkaufsanzeige.</p></div><div class="inquiry-panel"><h3>Interesse an diesem Fahrzeug?</h3><p>Im Prototyp kann das Formular getestet werden. Es versendet noch keine Daten.</p><InquiryForm vehicle={`${car.brand} ${car.model}`}/></div></div></section></Base>
