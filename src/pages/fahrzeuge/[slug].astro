---
import {withBase} from '../../utils/paths.js';
import Base from '../../layouts/Base.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import {cars} from '../../data/cars.js';
export function getStaticPaths(){return cars.map(car=>({params:{slug:car.slug},props:{car}}));}
const {car}=Astro.props;
---
<Base title={`${car.brand} ${car.model}`} description={`${car.brand} ${car.model} – Bildergalerie bei MS EMotion Cars.`}>
<section class="detail-top real-detail"><div class="shell">
  <a class="back-link" href={withBase('/fahrzeuge/')}>← ZURÜCK ZU DEN FAHRZEUGEN</a>
  <div class="detail-title"><div><span class="eyebrow eyebrow-dark">{car.brand.toUpperCase()} / THE COLLECTION</span><h1>{car.model}</h1></div><strong>Preis auf Anfrage</strong></div>
  {car.images.length ? <div class="vehicle-gallery" data-gallery>
    <div class="gallery-stage">
      <img class="gallery-main" src={withBase(car.images[0])} alt={`${car.brand} ${car.model}, Aufnahme 1`} width="1600" height="1067" fetchpriority="high" decoding="async"/>
      <button class="gallery-nav gallery-prev" type="button" aria-label="Vorheriges Bild">‹</button>
      <button class="gallery-nav gallery-next" type="button" aria-label="Nächstes Bild">›</button>
      <button class="gallery-fullscreen" type="button" aria-label="Bild in Vollbild öffnen">⛶ VERGRÖSSERN</button>
      <span class="gallery-count" aria-live="polite">1 / {car.images.length}</span>
    </div>
    <div class="gallery-thumbs" aria-label="Bildvorschau">
      {car.images.map((src,i)=><button type="button" class:list={['gallery-thumb',{active:i===0}]} data-image={withBase(src)} data-index={i} aria-label={`Bild ${i+1} von ${car.images.length} anzeigen`} aria-pressed={i===0}><img src={withBase(src)} alt="" loading="lazy" decoding="async" width="160" height="105"/></button>)}
    </div>
    <dialog class="gallery-dialog" aria-label="Fahrzeugbilder in Vollbild"><button class="gallery-close" type="button" aria-label="Vollbild schließen">✕</button><button class="gallery-modal-prev" type="button" aria-label="Vorheriges Bild">‹</button><img class="gallery-modal-image" alt={`${car.brand} ${car.model} – vergrößerte Aufnahme`}/><button class="gallery-modal-next" type="button" aria-label="Nächstes Bild">›</button><span class="gallery-modal-count"></span></dialog>
  </div> : <div class="gallery-pending">Die Studioaufnahmen für dieses Fahrzeug folgen in Kürze.</div>}
</div></section>
<section class="section detail-body"><div class="shell detail-columns">
  <div><span class="eyebrow eyebrow-dark">THE DETAILS</span><h2>Außergewöhnlich.<br/><em>Bis ins Detail.</em></h2><p>Entdecken Sie {car.brand} {car.model} in unserer Fahrzeuggalerie.</p><p class="muted">Technische Daten, Ausstattung und Preis ergänzen wir nach Prüfung der Fahrzeugangaben. Bitte kontaktieren Sie uns für weitere Informationen.</p></div>
  <div class="inquiry-panel"><h3>Interesse an diesem Fahrzeug?</h3><p>Das Anfrageformular ist derzeit noch ein Prototyp und versendet keine Daten.</p><InquiryForm vehicle={`${car.brand} ${car.model}`}/></div>
</div></section>
</Base>
<script>
document.querySelectorAll('[data-gallery]').forEach(gallery=>{
 const thumbs=[...gallery.querySelectorAll('.gallery-thumb')],main=gallery.querySelector('.gallery-main'),count=gallery.querySelector('.gallery-count'),dialog=gallery.querySelector('.gallery-dialog'),modal=gallery.querySelector('.gallery-modal-image'),modalCount=gallery.querySelector('.gallery-modal-count');let index=0,touchStart=null;
 function show(n){index=(n+thumbs.length)%thumbs.length;const t=thumbs[index];main.src=t.dataset.image;main.alt=`Fahrzeugaufnahme ${index+1} von ${thumbs.length}`;count.textContent=`${index+1} / ${thumbs.length}`;thumbs.forEach((b,i)=>{b.classList.toggle('active',i===index);b.setAttribute('aria-pressed',String(i===index));});t.scrollIntoView({block:'nearest',inline:'nearest',behavior:'smooth'});if(dialog.open){modal.src=t.dataset.image;modalCount.textContent=`${index+1} / ${thumbs.length}`;}}
 thumbs.forEach((t,i)=>t.addEventListener('click',()=>show(i)));
 gallery.querySelector('.gallery-prev').addEventListener('click',()=>show(index-1));
 gallery.querySelector('.gallery-next').addEventListener('click',()=>show(index+1));
 gallery.querySelector('.gallery-fullscreen').addEventListener('click',()=>{modal.src=thumbs[index].dataset.image;modalCount.textContent=`${index+1} / ${thumbs.length}`;dialog.showModal();});
 gallery.querySelector('.gallery-close').addEventListener('click',()=>dialog.close());
 gallery.querySelector('.gallery-modal-prev').addEventListener('click',()=>show(index-1));
 gallery.querySelector('.gallery-modal-next').addEventListener('click',()=>show(index+1));
 dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});
 gallery.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();show(index-1);}if(e.key==='ArrowRight'){e.preventDefault();show(index+1);}});
 gallery.querySelector('.gallery-stage').addEventListener('touchstart',e=>{touchStart=e.changedTouches[0].screenX;},{passive:true});
 gallery.querySelector('.gallery-stage').addEventListener('touchend',e=>{if(touchStart===null)return;const delta=e.changedTouches[0].screenX-touchStart;if(Math.abs(delta)>50)show(index+(delta<0?1:-1));touchStart=null;},{passive:true});
});
</script>
