---
import {withBase} from '../utils/paths.js';
import InnerHero from '../components/InnerHero.astro';import {cars} from '../data/cars.js';
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import copy from '../../content/pages/kontakt.json';
import team from '../../content/contact-team.json';
---
<Base title={copy.text_017} description="Kontaktieren Sie MS EMotion Cars, ein Markenauftritt der MS Automobile Roppen GmbH & Co. KG in Roppen, Tirol.">
<InnerHero eyebrow={copy.text_016} title={copy.text_018} accent={copy.text_019} description={copy.text_020} image="/images/kontakt.png" position="center 58%"/>
<section class="section" id="anfrage"><div class="shell split-layout">
 <div><span class="eyebrow eyebrow-dark">{copy.text_001}</span><h2>{copy.text_002}<br/><em>{copy.text_003}</em></h2>
 <p>{copy.text_004}</p>
 <div class="contact-placeholder">
 <strong>{copy.text_005}</strong><a href="tel:+43541763630">{copy.text_006}</a>
 <strong>{copy.text_007}</strong><a href="mailto:info@ms-automobile.at">{copy.text_008}</a>
 <strong>{copy.text_009}</strong><span>{copy.text_010}<br/>{copy.text_011}</span>
 <strong>{copy.text_012}</strong><span>{copy.text_013}</span>
 </div>
 <div class="contact-team">
  <span class="contact-person-kicker">IHRE ANSPRECHPARTNER</span>
  <div class="contact-team-image"><img src={withBase(team.image)} alt="Symbolisches Gruppenbild von drei Ansprechpartnern, ohne erkennbare Gesichter" loading="lazy" onerror="this.style.display='none'"/></div>
  <div class="contact-team-members">
   {team.members.map((member) => <div class="contact-team-member">
    <h3>{member.first_name} {member.last_name}</h3>
    <p>{member.role}</p>
    <div class="contact-team-detail"><span>Mobil</span><span>{member.mobile}</span></div>
    <div class="contact-team-detail"><span>E-Mail</span><span>{member.email}</span></div>
   </div>)}
  </div>
  <p class="contact-team-hint">Musterkontaktdaten – bitte vor Veröffentlichung durch die tatsächlichen Ansprechpartner ersetzen.</p>
 </div>
 </div>
 <div class="inquiry-panel"><h3>{copy.text_014}</h3><p>{copy.text_015}</p><InquiryForm kind="contact"/></div>
</div></section>
</Base>
<style>
.contact-team{margin-top:clamp(44px,5vw,78px);padding-top:clamp(28px,3vw,42px);border-top:1px solid #d7d8d6}
.contact-team-image{margin:20px 0 26px;aspect-ratio:16/9;background:#e2e2df;overflow:hidden}
.contact-team-image img{width:100%;height:100%;object-fit:cover}
.contact-team-members{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.contact-team-member{min-width:0;border-top:1px solid #d7d8d6;padding-top:16px}
.contact-team-member h3{font-family:'DM Sans',Arial,sans-serif;font-size:clamp(15px,1.5vw,20px);font-weight:600;letter-spacing:-.025em;margin:0 0 5px}
.contact-team-member p{font-size:12px;color:#777;line-height:1.5;margin:0 0 16px}
.contact-team-detail{display:flex;flex-direction:column;gap:3px;margin-bottom:12px;overflow-wrap:anywhere;font-size:11px;line-height:1.5}
.contact-team-detail span:first-child{font-weight:600;color:#242424}
.contact-team-detail span:last-child{color:#777}
.contact-team-hint{font-size:11px;color:#777;margin:16px 0 0}
@media(max-width:650px){.contact-team-members{grid-template-columns:1fr;gap:12px}.contact-team-member{padding-top:12px}}
</style>
