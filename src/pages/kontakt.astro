---
import InnerHero from '../components/InnerHero.astro';import {cars} from '../data/cars.js';
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
---
<Base title="Kontakt" description="Kontaktieren Sie MS EMotion Cars, ein Markenauftritt der MS Automobile Roppen GmbH & Co. KG in Roppen, Tirol.">
<InnerHero eyebrow="06 / GET IN TOUCH" title="Let's" accent="connect." description="Außergewöhnliche Fahrzeuge verdienen persönlichen Kontakt." image={cars[1]?.images[2]} position="center 58%"/>
<section class="section"><div class="shell split-layout">
 <div><span class="eyebrow eyebrow-dark">06 / CONTACT</span><h2>Der direkte<br/><em>Weg zu uns.</em></h2>
 <p>Wir freuen uns auf Ihre Anfrage zu unseren Fahrzeugen oder zum Fahrzeugankauf.</p>
 <div class="contact-placeholder">
 <strong>Telefon</strong><a href="tel:+43541763630">+43 5417 6363-0</a>
 <strong>E-Mail</strong><a href="mailto:info@ms-automobile.at">info@ms-automobile.at</a>
 <strong>Standort</strong><span>MS-Design-Straße 1<br/>6426 Roppen, Tirol, Österreich</span>
 <strong>Unternehmen</strong><span>MS Automobile Roppen GmbH &amp; Co. KG</span>
 </div>
 </div>
 <div class="inquiry-panel"><h3>Ihre Anfrage</h3><p>Ob Sie sich für eines unserer Fahrzeuge interessieren oder uns Ihr Fahrzeug anbieten möchten – wir freuen uns auf Ihre Nachricht.</p><InquiryForm kind="contact"/></div>
</div></section>
</Base>