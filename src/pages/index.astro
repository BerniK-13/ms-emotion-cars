---
import {withBase} from '../utils/paths.js';
import Base from '../layouts/Base.astro';import CarCard from '../components/CarCard.astro';import {cars} from '../data/cars.js';
---
<Base title="Exceptional Cars. Exceptional Passion." description="MS EMotion Cars – exklusiver digitaler Showroom für besondere Sportwagen und Premiumautomobile. Exklusive Fahrzeugauswahl."><section class="hero"><div class="hero-art" aria-hidden="true"><img src={withBase("/images/hero-porsche.png")} alt="" width="2048" height="682" fetchpriority="high" decoding="async"/></div><div class="shell hero-content"><div class="hero-copy"><span class="eyebrow">EXCLUSIVE AUTOMOBILES</span><h1>BEYOND<br/>THE <em>ORDINARY.</em></h1><p>Außergewöhnliche Automobile.<br/>Pure Leidenschaft.</p><a class="button button-outline" href={withBase("/fahrzeuge")}>FAHRZEUGE ENTDECKEN <span>↗</span></a></div></div><div class="hero-side">DRIVEN BY PASSION</div></section><section class="intro-strip"><div class="shell strip-inner"><span>01 / EXCLUSIVITY</span><p>Mehr als Automobile. Eine Leidenschaft für das Außergewöhnliche.</p><span>CURATED WITH PASSION ↗</span></div></section><section class="section collection"><div class="shell"><div class="section-heading"><div><span class="eyebrow eyebrow-dark">01 / IN STOCK</span><h2>Handverlesen.<br/><em>Außergewöhnlich.</em></h2></div><p>Eine bewusst ausgewählte Kollektion besonderer Automobile. Für Menschen, die mehr suchen als nur ein Fahrzeug.</p></div><div class="car-grid">{cars.slice(0,3).map(car=><CarCard car={car}/>)}</div><div class="section-end"><a class="text-link" href={withBase("/fahrzeuge")}>ALLE FAHRZEUGE ENTDECKEN <span>↗</span></a></div></div></section><section class="buy-section" style={`--carbon-url: url("${withBase("/images/carbon.jpeg")}")`}><div class="shell buy-content"><div><span class="eyebrow">02 / WE BUY EXCEPTIONAL CARS</span><h2>Ihr Fahrzeug.<br/><em>Unser Anspruch.</em></h2><p>Sie möchten ein exklusives Fahrzeug verkaufen? Wir freuen uns auf Ihre unverbindliche Anfrage.</p><a class="button button-outline" href={withBase("/ankauf")}>FAHRZEUG ANBIETEN <span>↗</span></a></div><div class="buy-art" aria-hidden="true"><span>EXCEPTIONAL<br/>BY NATURE.</span></div></div></section><section class="section philosophy"><div class="shell philosophy-grid"><div><span class="eyebrow eyebrow-dark">03 / OUR PHILOSOPHY</span><h2>Leidenschaft<br/>ist <em>unser Antrieb.</em></h2></div><div><p>MS EMotion Cars steht für die Faszination außergewöhnlicher Fahrzeuge und einen bewusst persönlichen Zugang. Hier entsteht ein digitaler Ort für automobile Besonderheiten.</p><p class="muted">Die endgültige Unternehmensvorstellung und konkrete Leistungsversprechen werden vor dem Livegang mit echten Informationen ergänzt.</p><a class="text-link" href={withBase("/ueber-uns")}>MEHR ÜBER UNS <span>↗</span></a></div></div></section><section class="values"><div class="shell values-grid"><div><span class="value-number">01</span><h3>Exklusive Auswahl</h3><p>Bewusst kuratiertes Angebot.</p></div><div><span class="value-number">02</span><h3>Persönlicher Kontakt</h3><p>Direkte Ansprechpartner.</p></div><div><span class="value-number">03</span><h3>Leidenschaft</h3><p>Für besondere Automobile.</p></div></div></section></Base>
