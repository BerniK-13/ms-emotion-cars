---
import {withBase} from '../utils/paths.js';
import Base from '../layouts/Base.astro';import CarCard from '../components/CarCard.astro';import {cars} from '../data/cars.js';
---
<Base title="Exceptional Cars. Exceptional Passion." description="MS EMotion Cars – exklusiver digitaler Showroom für besondere Sportwagen und Premiumautomobile. Exklusive Fahrzeugauswahl."><section class="hero"><div class="hero-art" aria-hidden="true"><img src={withBase("/images/hero-porsche.png")} alt="" width="2048" height="682" fetchpriority="high" decoding="async"/></div><div class="shell hero-content"><div class="hero-copy"><span class="eyebrow">EXCLUSIVE AUTOMOBILES</span><h1>BEYOND<br/>THE <em>ORDINARY.</em></h1><p>Außergewöhnliche Automobile für pure Leidenschaft.</p><a class="button button-outline" href={withBase("/fahrzeuge")}>FAHRZEUGE ENTDECKEN <span>↗</span></a></div></div></section><section class="intro-strip"><div class="shell strip-inner"><span>EXCLUSIVITY</span><p>Not for everyone. Rare for a reason.</p><span>CURATED WITH PASSION ↗</span></div></section><section class="section collection"><div class="shell"><div class="section-heading"><div><span class="eyebrow eyebrow-dark">01 / IN STOCK</span><h2>Handverlesen.<br/><em>Außergewöhnlich.</em></h2></div><p>Eine bewusst ausgewählte Kollektion besonderer Automobile. Für Menschen, die mehr suchen als nur ein Fahrzeug.</p></div><div class="car-grid">{cars.slice(0,3).map(car=><CarCard car={car}/>)}</div><div class="section-end"><a class="text-link" href={withBase("/fahrzeuge")}>ALLE FAHRZEUGE ENTDECKEN <span>↗</span></a></div></div></section><section class="buy-section" style={`--carbon-url: url("${withBase("/images/carbon.jpeg")}")`}><div class="shell buy-content"><div><span class="eyebrow">04 / WE BUY EXCEPTIONAL CARS</span><h2>Ihr Fahrzeug.<br/><em>Unser Anspruch.</em></h2><p>Sie möchten ein exklusives Fahrzeug verkaufen? Wir freuen uns auf Ihre unverbindliche Anfrage.</p><a class="button button-outline" href={withBase("/ankauf")}>FAHRZEUG ANBIETEN <span>↗</span></a></div><div class="buy-art" aria-hidden="true"></div></div></section><section class="section philosophy"><div class="shell philosophy-grid"><div><span class="eyebrow eyebrow-dark">05 / OUR PHILOSOPHY</span><h2>Leidenschaft<br/>ist <em>unser Antrieb.</em></h2></div><div><p>MS EMotion Cars steht für die Faszination außergewöhnlicher Fahrzeuge und einen bewusst persönlichen Zugang. Hier entsteht ein digitaler Ort für automobile Besonderheiten.</p><p class="muted">Die endgültige Unternehmensvorstellung und konkrete Leistungsversprechen werden vor dem Livegang mit echten Informationen ergänzt.</p><a class="text-link" href={withBase("/ueber-uns")}>MEHR ÜBER UNS <span>↗</span></a></div></div></section><section class="values" aria-label="Schnellnavigation"><nav class="shell values-grid" aria-label="Weitere Seiten"><a class="value-link" href={withBase("/fahrzeuge")}><span class="value-number">01</span><h3>In Stock</h3><p>Exklusive Automobile.</p></a><a class="value-link" href={withBase("/referenzen")}><span class="value-number">02</span><h3>Referenzen</h3><p>Besondere Geschichten.</p></a><a class="value-link" href={withBase("/ms-collection")}><span class="value-number">03</span><h3>MS Collection</h3><p>Off the track.</p></a><a class="value-link" href={withBase("/ankauf")}><span class="value-number">04</span><h3>Ankauf</h3><p>Ihr Fahrzeug. Unser Anspruch.</p></a><a class="value-link" href={withBase("/ueber-uns")}><span class="value-number">05</span><h3>Über uns</h3><p>Was uns antreibt.</p></a><a class="value-link" href={withBase("/kontakt")}><span class="value-number">06</span><h3>Kontakt</h3><p>Persönlich. Direkt.</p></a></nav></section></Base>
