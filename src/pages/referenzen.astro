---
import ScrollReveal from '../components/ScrollReveal.astro';
import Base from '../layouts/Base.astro';
import {withBase} from '../utils/paths.js';
import copy from '../../content/pages/referenzen.json';
import {soldCars} from '../data/cars.js';
---
<Base title={copy.text_043} description="MS EMotion Cars – ausgewählte Referenzen erfolgreich vermittelter Automobile.">
  <section class="collection-hero references-hero" style={`--references-hero-image: url("${withBase("/images/Porsche GT3 und Mercedes G‑Klasse im Showroom.png")}")`}><div class="shell"><span class="eyebrow">{copy.text_001}</span><h1>{copy.text_002}<br/><em>{copy.text_003}</em></h1><p>Besondere Automobile.<br/>Persönliche Geschichten.</p></div></section>
  <section class="ms-shop section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">{copy.text_005}</span><h2>{copy.text_006}<br/><em>{copy.text_007}</em></h2></div><p>{copy.text_008}</p></div><div class="car-grid reference-grid" data-scroll-reveal>{soldCars.map(car => <a class="car-card reference-card" data-scroll-reveal-card href={withBase('/fahrzeuge/' + car.slug + '/')}><div class="car-photo reference-photo">{car.image ? <img src={withBase(car.image)} alt={car.brand + ' ' + car.model} loading="lazy" decoding="async" width="1200" height="800"/> : <div class="gallery-pending">Fahrzeugbild folgt</div>}<span class="reference-sold">SOLD</span></div><div class="car-info"><div><span class="car-brand">{car.brand}</span><h3>{car.model}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></a>)}</div>{soldCars.length === 0 && <p class="reference-preview-note">Unsere verkauften Fahrzeuge und Referenzen werden hier in Kürze präsentiert.</p>}<div class="ms-shop-outro"><h2>{copy.text_040}<br/><em>{copy.text_041}</em></h2><a class="button button-outline" href={withBase('/kontakt')}>{copy.text_042} <span aria-hidden="true">↗</span></a></div></div></section>
  <ScrollReveal/>
</Base>
