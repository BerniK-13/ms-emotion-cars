---
import Base from '../layouts/Base.astro';
import {withBase} from '../utils/paths.js';
---
<Base title="Referenzen" description="MS EMotion Cars – ausgewählte Referenzen erfolgreich vermittelter Automobile.">
  <section class="collection-hero references-hero" style={`--references-hero-image: url("${withBase("/images/Porsche GT3 und Mercedes G‑Klasse im Showroom.png")}")`}><div class="shell"><span class="eyebrow">02 / REFERENZEN</span><h1>GONE.<br/><em>NOT FORGOTTEN.</em></h1><p>Besondere Automobile. Persönliche Geschichten.</p></div></section>
  <section class="ms-shop section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">02 / UNSERE REFERENZEN</span><h2>Erfolgreich vermittelt.<br/><em>Mit Leidenschaft.</em></h2></div><p>Hier präsentieren wir künftig eine Auswahl tatsächlich verkaufter Fahrzeuge – mit Bildern, technischen Details und ohne Preisangaben.</p></div><p class="collection-notice">DIE REFERENZGALERIE IST IN VORBEREITUNG. Sobald freigegebene Verkaufsreferenzen vorliegen, ergänzen wir die Fahrzeuge hier.</p><div class="ms-shop-outro"><h2>Ihre Leidenschaft.<br/><em>Unser Antrieb.</em></h2><a class="button button-outline" href={withBase('/kontakt')}>KONTAKT AUFNEHMEN <span aria-hidden="true">↗</span></a></div></div></section>
</Base>
