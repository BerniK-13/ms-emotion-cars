---
import ScrollReveal from '../components/ScrollReveal.astro';
import Base from '../layouts/Base.astro';
import {withBase} from '../utils/paths.js';
import copy from '../../content/pages/referenzen.json';
import {soldCars} from '../data/cars.js';
---
<Base title={copy.text_043} description="MS EMotion Cars – ausgewählte Referenzen erfolgreich vermittelter Automobile.">
  <section class="collection-hero references-hero" style={`--references-hero-image: url("${withBase("/images/Porsche GT3 und Mercedes G‑Klasse im Showroom.png")}")`}><div class="shell"><span class="eyebrow">{copy.text_001}</span><h1>{copy.text_002}<br/><em>{copy.text_003}</em></h1><p>Besondere Automobile.<br/>Persönliche Geschichten.</p></div></section>
  <section class="ms-shop section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">{copy.text_005}</span><h2>{copy.text_006}<br/><em>{copy.text_007}</em></h2></div><p>{copy.text_008}</p></div><div class="car-grid reference-grid" data-scroll-reveal><article class="car-card reference-card" data-scroll-reveal-card><div class="car-photo reference-photo"><img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=85" alt="Symbolbild für Referenz 01, kein dokumentierter Verkauf" loading="lazy" decoding="async" width="1200" height="800"/><span class="reference-sold">{copy.text_010}</span></div><div class="car-info"><div><span class="car-brand">{copy.text_012}</span><h3>{copy.text_013}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></article>
<article class="car-card reference-card" data-scroll-reveal-card><div class="car-photo reference-photo"><img src={withBase('/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(01).jpg')} alt="Symbolbild für Referenz 02, kein dokumentierter Verkauf" loading="lazy" decoding="async" width="1200" height="800"/><span class="reference-sold">{copy.text_015}</span></div><div class="car-info"><div><span class="car-brand">{copy.text_017}</span><h3>{copy.text_018}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></article>
<article class="car-card reference-card" data-scroll-reveal-card><div class="car-photo reference-photo"><img src={withBase('/images/fahrzeuge/bmw-m3-cs-touring/MSA-08712.jpg')} alt="Symbolbild für Referenz 03, kein dokumentierter Verkauf" loading="lazy" decoding="async" width="1200" height="800"/><span class="reference-sold">{copy.text_020}</span></div><div class="car-info"><div><span class="car-brand">{copy.text_022}</span><h3>{copy.text_023}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></article>
<article class="car-card reference-card" data-scroll-reveal-card><div class="car-photo reference-photo"><img src={withBase('/images/fahrzeuge/porsche-992-2-gt3-weissach-silber/Porsche%20992.2%20GT3%20weissach%20silber%20(03).jpg')} alt="Symbolbild für Referenz 04, kein dokumentierter Verkauf" loading="lazy" decoding="async" width="1200" height="800"/><span class="reference-sold">{copy.text_025}</span></div><div class="car-info"><div><span class="car-brand">{copy.text_027}</span><h3>{copy.text_028}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></article>
<article class="car-card reference-card" data-scroll-reveal-card><div class="car-photo reference-photo"><img src="https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=1200&q=85" alt="Symbolbild für Referenz 05, kein dokumentierter Verkauf" loading="lazy" decoding="async" width="1200" height="800"/><span class="reference-sold">{copy.text_030}</span></div><div class="car-info"><div><span class="car-brand">{copy.text_032}</span><h3>{copy.text_033}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></article>
<article class="car-card reference-card" data-scroll-reveal-card><div class="car-photo reference-photo"><img src="https://images.unsplash.com/photo-1494905998402-395d579af36f?auto=format&fit=crop&w=1200&q=85" alt="Symbolbild für Referenz 06, kein dokumentierter Verkauf" loading="lazy" decoding="async" width="1200" height="800"/><span class="reference-sold">{copy.text_035}</span></div><div class="car-info"><div><span class="car-brand">{copy.text_037}</span><h3>{copy.text_038}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></article></div><p class="reference-preview-note">Visualisierung mit Platzhalterfahrzeugen. Originale Verkaufsreferenzen werden nach Freigabe ergänzt.</p>{soldCars.length > 0 && <><div class="section-heading"><div><span class="eyebrow">MS EMOTION CARS</span><h2>VERKAUFTE <em>FAHRZEUGE.</em></h2></div></div><div class="car-grid reference-grid" data-scroll-reveal>{soldCars.map(car => <a class="car-card reference-card" data-scroll-reveal-card href={withBase('/fahrzeuge/' + car.slug + '/')}><div class="car-photo reference-photo">{car.image && <img src={withBase(car.image)} alt={car.brand + ' ' + car.model} loading="lazy" decoding="async" width="1200" height="800"/>}<span class="reference-sold">SOLD</span></div><div class="car-info"><div><span class="car-brand">{car.brand}</span><h3>{car.model}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div></a>)}</div></>}<div class="ms-shop-outro"><h2>{copy.text_040}<br/><em>{copy.text_041}</em></h2><a class="button button-outline" href={withBase('/kontakt')}>{copy.text_042} <span aria-hidden="true">↗</span></a></div></div></section>
  <ScrollReveal/>
</Base>
