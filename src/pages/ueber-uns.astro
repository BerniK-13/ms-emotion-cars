---
import {withBase} from '../utils/paths.js';
import InnerHero from '../components/InnerHero.astro';
import Base from '../layouts/Base.astro';
import copy from '../../content/pages/ueber-uns.json';
---
<Base title={copy.text_034} description="MS Emotion Cars: Exklusive Sport- und Luxusautomobile, fundierte Marktkenntnis und technisches Know-how aus der Automobilindustrie durch Partnerbetrieb MS Design.">
  <InnerHero eyebrow={copy.text_033} title={copy.text_035} accent={copy.text_036} description={copy.text_037} image="/images/ueberuns.png" position="center 55%"/>
  <section class="section"><div class="shell philosophy-grid"><div><span class="eyebrow eyebrow-dark">{copy.text_001}</span><h2>{copy.text_002}<br/><em>{copy.text_003}</em></h2></div><div><p>{copy.text_004}</p><p>{copy.text_005}</p><p>{copy.text_006}</p></div></div></section>
  <section class="section philosophy-carbon" style={`--philosophy-carbon-image: url("${withBase("/images/carbon.jpeg")}")`}><div class="shell philosophy-grid"><div><span class="eyebrow" style="color:#bdbdbd">{copy.text_007}</span><h2 style="color:inherit">{copy.text_008}<br/><em>{copy.text_009}</em></h2></div><div><p>{copy.text_010}</p><p>{copy.text_011}</p><p>{copy.text_012}</p><p style="font-weight:600;color:#fff">{copy.text_013}</p></div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><div><span class="eyebrow eyebrow-dark">{copy.text_014}</span><h2>{copy.text_015}<br/><em>{copy.text_016}</em></h2></div><p>{copy.text_017}</p></div><div class="about-values"><article><span>01</span><h3>{copy.text_018}</h3><p>{copy.text_019}</p></article><article><span>02</span><h3>{copy.text_020}</h3><p>{copy.text_021}</p></article><article><span>03</span><h3>{copy.text_022}</h3><p>{copy.text_023}</p></article><article><span>04</span><h3>{copy.text_024}</h3><p>{copy.text_025}</p></article></div></div></section>
  <section class="section" style="background:#111;color:#fff"><div class="shell philosophy-grid"><div><span class="eyebrow" style="color:#bbb">{copy.text_026}</span><h2 style="color:inherit">{copy.text_027}<br/><em>{copy.text_028}</em></h2></div><div><p>{copy.text_029}</p><p>{copy.text_030}</p><a class="button button-outline" href={withBase("/kontakt")}>{copy.text_031} <span>↗</span></a><p style="margin-top:2rem;letter-spacing:.15em;font-size:.8rem">{copy.text_032}</p></div></div></section>
</Base>
<style>
.about-values{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3rem 4rem;margin-top:3rem}
.about-values article{border-top:1px solid #bbb;padding-top:1.5rem}
.about-values article span{display:block;color:#a1a1a1;font-size:.85rem;letter-spacing:.15em;margin-bottom:1.3rem}
.about-values article h3{font-size:clamp(1.05rem,1.7vw,1.45rem);letter-spacing:.035em;line-height:1.3;margin:0 0 1rem}
.about-values article p{line-height:1.75;margin:0}
@media(max-width:700px){.about-values{grid-template-columns:1fr;gap:2rem}}

/* Carbon texture on the philosophy/trust section, with dark overlay for legible text. */
.philosophy-carbon{position:relative;isolation:isolate;background-color:#111;color:#f4f4f4}
.philosophy-carbon::before{content:"";position:absolute;inset:0;z-index:-1;background-image:linear-gradient(90deg,rgba(12,13,14,.90),rgba(12,13,14,.82)),var(--philosophy-carbon-image);background-size:cover;background-position:center;pointer-events:none}
</style>