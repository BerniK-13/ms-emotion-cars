<style is:global>
/* Home-only reveal. Content is visible by default without JS. */
@media (prefers-reduced-motion: no-preference) {
  .home-reveal-ready .home-reveal-item {
    transition: opacity 780ms ease, transform 780ms cubic-bezier(.22,1,.36,1);
  }
  .home-reveal-ready .home-reveal-item:not(.home-reveal-shown) {
    opacity: 0;
    transform: translate3d(0,24px,0);
  }
  .home-reveal-ready .home-reveal-item.home-reveal-shown {
    opacity: 1;
    transform: translate3d(0,0,0);
  }
}
</style>
<script>
  const targets = [
    ...document.querySelectorAll('[data-home-reveal]'),
    ...document.querySelectorAll('[data-home-reveal-group] > *')
  ];
  if (targets.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('home-reveal-shown');
        observer.unobserve(entry.target);
      }
    }, {threshold:0.06,rootMargin:'0px 0px 40px 0px'});
    for (const target of targets) {
      target.classList.add('home-reveal-item');
      const rect = target.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) target.classList.add('home-reveal-shown');
      else observer.observe(target);
    }
    document.body.classList.add('home-reveal-ready');
  }
</script>
