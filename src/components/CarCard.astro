---
import {withBase} from '../utils/paths.js';
import {euro} from '../data/cars.js';
const {car}=Astro.props;
const facts=car.facts || [];
---
<a class="car-card" href={withBase('/fahrzeuge/'+car.slug+'/')} aria-label={`${car.brand} ${car.model} – Details ansehen`}>
  <div class="car-photo">
    {car.image ? <img src={withBase(car.image)} alt={`${car.brand} ${car.model} – Original-Studioaufnahme`} loading="lazy" decoding="async" width="1200" height="800"/> : <div class="car-photo-pending">FOTOS FOLGEN</div>}
    <span class="car-tag">{car.tag}</span>
  </div>
  <div class="car-info"><div><span class="car-brand">{car.brand}</span><h3>{car.model}</h3></div><span class="car-arrow" aria-hidden="true">↗</span></div>
  <div class="car-meta">{facts.length ? facts.slice(0,3).map(f=><span>{f.value}</span>) : <span>{car.images.length ? `${car.images.length} Fahrzeugfotos` : 'Fotos in Vorbereitung'}</span>}</div>
  <div class="car-price">{euro(car.price)}</div>
</a>
