<style is:global>
/* Banner content stays visible without JavaScript and when reduced motion is preferred. */
@media (prefers-reduced-motion: no-preference) {
  .hero-sequence-active .hero-sequence-item {
    animation: hero-sequence-enter 850ms cubic-bezier(.22,1,.36,1) both;
    animation-delay: var(--hero-sequence-delay, 0ms);
  }
  @keyframes hero-sequence-enter {
    from { opacity: 0; transform: translate3d(0,18px,0); }
    to { opacity: 1; transform: translate3d(0,0,0); }
  }
}
</style>
<script>
  // Run once per large banner. No dependency, no changes to banner markup or layout.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.hero .hero-copy, .inner-hero .inner-hero-content, .collection-hero > .shell').forEach(container => {
      const elements = Array.from(container.children).filter(el =>
        el.matches('.eyebrow, h1, p, a.button')
      );
      if (!elements.length) return;
      elements.forEach((element, index) => {
        element.classList.add('hero-sequence-item');
        element.style.setProperty('--hero-sequence-delay', String(120 + index * 200) + 'ms');
      });
      container.classList.add('hero-sequence-active');
    });
  }
</script>
