---
import {withBase} from '../utils/paths.js';
const {kind='contact',vehicle=''}=Astro.props;
---
<form class="inquiry-form" data-demo-form><div class="form-grid"><label>Vorname *<input name="firstName" autocomplete="given-name" required maxlength="80"/></label><label>Nachname *<input name="lastName" autocomplete="family-name" required maxlength="80"/></label><label>E-Mail *<input type="email" name="email" autocomplete="email" required maxlength="180"/></label><label>Telefon<input type="tel" name="phone" autocomplete="tel" maxlength="50"/></label>{kind==='purchase'&&<label class="full">Fahrzeug / Marke<input name="vehicle" placeholder="z. B. Porsche 911 GT3" maxlength="150"/></label>}<label class="full">Ihre Nachricht *<textarea name="message" rows="5" required maxlength="3000" placeholder={vehicle?`Ich interessiere mich für ${vehicle} …`:'Wie können wir Ihnen helfen?'}></textarea></label></div><label class="privacy-check"><input type="checkbox" required/> <span>Ich habe die <a href={withBase("/datenschutz")}>Datenschutzhinweise</a> gelesen und stimme der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage zu. *</span></label><button class="button button-dark" type="submit">ANFRAGE VORBEREITEN <span>↗</span></button><p class="form-note" role="status">Demo-Modus: Es werden keine Daten gesendet oder gespeichert.</p></form>
<script>document.querySelectorAll('[data-demo-form]').forEach(form=>form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const status=form.querySelector('.form-note');status.textContent='Demo erfolgreich geprüft. Es wurde KEINE Anfrage verschickt. Für den Livebetrieb muss ein sicherer Formularversand eingerichtet werden.';status.classList.add('notice');}));</script>
