---
import {withBase} from '../utils/paths.js';
import {cars} from '../data/cars.js';
const {kind='contact',vehicle=''}=Astro.props;
---
{kind==='contact' ? (
<form class="inquiry-form contact-inquiry" data-contact-inquiry action="https://formsubmit.co/bwalser13@gmail.com" method="POST" enctype="multipart/form-data">
 <input type="hidden" name="_captcha" value="true"/><input type="hidden" name="_template" value="table"/><input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="_subject" value="MS EMotion Cars – Website-Anfrage"/><div class="form-grid">
  <label class="full">Name *<input name="name" autocomplete="name" required maxlength="160" placeholder="Vor- und Nachname"/></label>
  <label>E-Mail-Adresse *<input type="email" name="email" autocomplete="email" required maxlength="180" placeholder="name@beispiel.at"/></label>
  <label>Telefonnummer *<input type="tel" name="phone" autocomplete="tel" required maxlength="50" placeholder="+43 …"/></label>
  <label class="full">Worum geht es? *<select name="topic" required data-inquiry-topic><option value="">Bitte auswählen</option><option value="verkauf">Fahrzeugverkauf – Ich interessiere mich für ein Fahrzeug</option><option value="ankauf">Fahrzeugankauf – Ich möchte mein Fahrzeug anbieten</option><option value="produkt">Produktanfrage – MS Collection</option></select></label>
  <label class="full" data-vehicle-field hidden>Welches Fahrzeug interessiert Sie? *<select name="vehicle" data-inquiry-vehicle disabled><option value="">Bitte Fahrzeug auswählen</option>{cars.map(car=><option value={`${car.brand} ${car.model}`}>{car.brand} {car.model}</option>)}</select></label>
  <label class="full" data-product-field hidden>Welches Produkt interessiert Sie? *<input name="product" data-inquiry-product maxlength="180" disabled placeholder="Produkt aus der MS Collection"/></label>
  <label class="full">Bemerkungen<textarea name="message" rows="5" maxlength="3000" placeholder="Ihre Fragen oder weitere Informationen …"></textarea></label>
 </div>
 <label class="privacy-check"><input type="checkbox" required/> <span>Ich habe die <a href={withBase('/datenschutz')}>Datenschutzhinweise</a> gelesen. *</span></label>
 <button class="button button-dark" type="submit">ANFRAGE SENDEN <span aria-hidden="true">↗</span></button>
 <p class="form-note" role="status">Ihre Anfrage wird über den Formularservice FormSubmit an bwalser13@gmail.com übermittelt. Nach dem Absenden erscheint eine Bestätigungsseite.</p>
</form>
) : (
<form class="inquiry-form" data-demo-form action="https://formsubmit.co/bwalser13@gmail.com" method="POST" enctype="multipart/form-data"><input type="hidden" name="_captcha" value="true"/><input type="hidden" name="_template" value="table"/><input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="_subject" value="MS EMotion Cars – Fahrzeuganfrage"/><div class="form-grid"><label>Vorname *<input name="firstName" autocomplete="given-name" required maxlength="80"/></label><label>Nachname *<input name="lastName" autocomplete="family-name" required maxlength="80"/></label><label>E-Mail *<input type="email" name="email" autocomplete="email" required maxlength="180"/></label><label>Telefon<input type="tel" name="phone" autocomplete="tel" maxlength="50"/></label>{kind==='purchase'&&<label class="full">Fahrzeug / Marke<input name="vehicle" placeholder="z. B. Porsche 911 GT3" maxlength="150"/></label>}{kind==='purchase'&&<div class="full purchase-photos"><label for="purchase-images">Fahrzeugfotos hinzufügen</label><input id="purchase-images" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple data-purchase-images aria-describedby="purchase-image-help"/><p id="purchase-image-help">Bis zu 10 Bilder (JPG, PNG oder WebP), zusammen maximal 10 MB. Die ausgewählten Bilder werden mit der Anfrage übermittelt.</p><div class="purchase-image-preview" data-purchase-preview aria-live="polite"></div></div>}<label class="full">Ihre Nachricht *<textarea name="message" rows="5" required maxlength="3000" placeholder={vehicle?`Ich interessiere mich für ${vehicle} …`:'Wie können wir Ihnen helfen?'}></textarea></label></div><label class="privacy-check"><input type="checkbox" required/> <span>Ich habe die <a href={withBase('/datenschutz')}>Datenschutzhinweise</a> gelesen. *</span></label><button class="button button-dark" type="submit">ANFRAGE SENDEN <span>↗</span></button><p class="form-note" role="status">Ihre Anfrage wird über FormSubmit an bwalser13@gmail.com gesendet. Ausgewählte Fahrzeugbilder werden mit übertragen (insgesamt maximal 10 MB).</p></form>
)}
<script>
document.querySelectorAll('[data-contact-inquiry]').forEach(form=>{
 const topic=form.querySelector('[data-inquiry-topic]');
 const field=form.querySelector('[data-vehicle-field]');
 const vehicle=form.querySelector('[data-inquiry-vehicle]');
 const productField=form.querySelector('[data-product-field]');
 const product=form.querySelector('[data-inquiry-product]');
 function update(){const show=topic.value==='verkauf';const isProduct=topic.value==='produkt';field.hidden=!show;vehicle.disabled=!show;vehicle.required=show;if(!show)vehicle.value='';productField.hidden=!isProduct;product.disabled=!isProduct;product.required=isProduct;if(!isProduct)product.value='';}
 const params=new URLSearchParams(window.location.search);
 if(params.get('topic')==='verkauf'){topic.value='verkauf';const requested=(params.get('vehicle')||'').trim();if([...vehicle.options].some(option=>option.value===requested))vehicle.value=requested;}
 if(params.get('topic')==='produkt'){topic.value='produkt';product.value=(params.get('product')||'').slice(0,180);const selections=[params.get('size')?'Größe: '+params.get('size'):'',params.get('color')?'Farbe: '+params.get('color'):''].filter(Boolean);if(selections.length)form.querySelector('textarea[name="message"]').value='Gewünschte Ausführung: '+selections.join(', ');}
 topic.addEventListener('change',update);update();

});
document.querySelectorAll('[data-purchase-images]').forEach(input=>{
 const preview=input.closest('.purchase-photos').querySelector('[data-purchase-preview]');
 let selected=[];
 function render(){preview.replaceChildren();selected.forEach((file,index)=>{const item=document.createElement('div');item.className='purchase-image-item';const img=document.createElement('img');const url=URL.createObjectURL(file);img.src=url;img.alt='Vorschau '+file.name;img.onload=()=>URL.revokeObjectURL(url);const remove=document.createElement('button');remove.type='button';remove.textContent='Entfernen';remove.setAttribute('aria-label',file.name+' entfernen');remove.addEventListener('click',()=>{selected.splice(index,1);sync();});item.append(img,remove);preview.append(item);});}
 function sync(){const dt=new DataTransfer();selected.forEach(file=>dt.items.add(file));input.files=dt.files;render();}
 input.addEventListener('change',()=>{const incoming=Array.from(input.files);const combined=[...selected,...incoming];if(combined.length>10||combined.reduce((sum,file)=>sum+file.size,0)>10*1024*1024||combined.some(file=>!['image/jpeg','image/png','image/webp'].includes(file.type))){alert('Bitte maximal 10 Bilder als JPG, PNG oder WebP mit insgesamt höchstens 10 MB auswählen.');sync();return;}selected=combined;sync();});
});
document.querySelectorAll('[data-demo-form]').forEach(form=>form.addEventListener('submit',e=>{const files=form.querySelector('[data-purchase-images]')?.files;if(files&&Array.from(files).reduce((sum,file)=>sum+file.size,0)>10*1024*1024){e.preventDefault();alert('Die Fahrzeugbilder dürfen zusammen maximal 10 MB groß sein. Bitte wählen Sie kleinere Bilder.');}}));
</script>
